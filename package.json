{
  "name": "owui-agent",
  "displayName": "OWUI Agent",
  "description": "Autonomous coding agent that talks only to your self-hosted Open WebUI.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "owuiAgent",
          "title": "OWUI Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "owuiAgent": [
        {
          "type": "webview",
          "id": "owuiAgent.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "owuiAgent.setApiKey",
        "title": "Set API Key",
        "category": "OWUI Agent"
      },
      {
        "command": "owuiAgent.clearApiKey",
        "title": "Clear API Key",
        "category": "OWUI Agent"
      },
      {
        "command": "owuiAgent.newSession",
        "title": "New Session",
        "category": "OWUI Agent",
        "icon": "$(add)"
      },
      {
        "command": "owuiAgent.refreshModels",
        "title": "Refresh Models",
        "category": "OWUI Agent",
        "icon": "$(refresh)"
      },
      {
        "command": "owuiAgent.stop",
        "title": "Stop",
        "category": "OWUI Agent"
      },
      {
        "command": "owuiAgent.showSovereigntyNotice",
        "title": "Show Data Sovereignty Notice",
        "category": "OWUI Agent"
      },
      {
        "command": "owuiAgent.addSelection",
        "title": "Add Selection to Chat",
        "category": "OWUI Agent"
      },
      {
        "command": "owuiAgent.addFile",
        "title": "Add File to Chat",
        "category": "OWUI Agent"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "owuiAgent.newSession",
          "when": "view == owuiAgent.chat",
          "group": "navigation@1"
        },
        {
          "command": "owuiAgent.refreshModels",
          "when": "view == owuiAgent.chat",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "owuiAgent.addSelection",
          "when": "editorHasSelection",
          "group": "owuiAgent@1"
        }
      ],
      "explorer/context": [
        {
          "command": "owuiAgent.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "owuiAgent@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "owuiAgent.stop",
        "key": "escape",
        "when": "focusedView == owuiAgent.chat"
      },
      {
        "command": "owuiAgent.addSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "OWUI Agent",
      "properties": {
        "owuiAgent.baseUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "markdownDescription": "Base URL of your Open WebUI instance. The extension sends network requests **only** to this origin.",
          "scope": "application"
        },
        "owuiAgent.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Model ID to select by default."
        },
        "owuiAgent.models": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-model overrides, keyed by model ID. Fields: `toolMode` (`auto` | `native` | `text`), `contextSize` (tokens; also sent to Ollama as `num_ctx`, so Ollama loads the model with that context), `vision` (boolean), `local` (boolean: you confirm the model runs on infrastructure you control), `thinking` (boolean: `false` asks Ollama models to skip their reasoning phase, which is much faster).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "toolMode": {
                "type": "string",
                "enum": [
                  "auto",
                  "native",
                  "text"
                ]
              },
              "contextSize": {
                "type": "integer",
                "minimum": 512
              },
              "vision": {
                "type": "boolean"
              },
              "local": {
                "type": "boolean"
              },
              "thinking": {
                "type": "boolean"
              }
            }
          }
        },
        "owuiAgent.request.stallTimeoutSeconds": {
          "type": "integer",
          "default": 300,
          "minimum": 10,
          "description": "Abort a model request when the stream goes silent for this many seconds after it has started responding."
        },
        "owuiAgent.request.maxRetries": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Retries for connection errors, HTTP 429 and 5xx responses."
        },
        "owuiAgent.shell.windows": {
          "type": "string",
          "enum": [
            "auto",
            "gitbash",
            "powershell",
            "cmd"
          ],
          "default": "auto",
          "markdownDescription": "Shell for agent commands on Windows. `auto` uses Git Bash when installed, otherwise PowerShell."
        },
        "owuiAgent.shell.posix": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "zsh",
            "sh"
          ],
          "default": "auto",
          "description": "Shell for agent commands on macOS and Linux. auto prefers bash."
        },
        "owuiAgent.commands.timeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 5,
          "maximum": 3600,
          "description": "Default timeout for run_command. The agent can request a longer one per command."
        },
        "owuiAgent.commands.allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Commands that run without asking, matched as word prefixes (e.g. `npm test`, `git status`, `npx tsc`). Commands that change Git history, publish, launch applications, start services or use sudo always ask. Use `*` as a wildcard word."
        },
        "owuiAgent.agent.maxIterations": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Model turns per request before the agent pauses and asks to continue."
        },
        "owuiAgent.scratchpad.retentionDays": {
          "type": "integer",
          "default": 7,
          "minimum": 0,
          "description": "Delete scratchpad folders older than this many days at startup."
        },
        "owuiAgent.request.firstResponseTimeoutSeconds": {
          "type": "integer",
          "default": 1200,
          "minimum": 30,
          "description": "How long to wait for the model to start responding. CPU-only servers may need minutes to load a model or read a long prompt."
        },
        "owuiAgent.checkpoints.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Snapshot the workspace before each request in a private git repository inside VS Code's extension storage (never your own repository), so you can rewind. Requires git. When off, only files the agent edits are backed up."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:egress": "vitest run test/egress",
    "test:integration": "node esbuild.mjs && node test/integration/run.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:integration",
    "smoke:live": "node scripts/smoke-live.mjs",
    "package": "node scripts/package-vsix.mjs",
    "smoke:agent": "node scripts/live-agent.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.4",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "mocha": "11.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
